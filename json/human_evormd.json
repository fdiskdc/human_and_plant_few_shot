{
  "experiment_name": "evormd_human",

  "data": {
    "human_data_dir": "npy/human3",
    "cache_dir": "npy/cache"
  },

  "model": {
    "use_hierarchical": true,
    "d_fm": 640,
    "mlp_depth": 2,
    "conv_kernel_size": 7,
    "conv_dropout": 0.1,
    "num_classes": 12
  },

  "training": {
    "batch_size": 240,
    "num_epochs": 100,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "warmup_epochs": 2,
    "train_ratio": 0.7,
    "random_seed": 666,
    "eval_threshold": 0.5,
    "test_interval": 10,
    "save_every_epoch": true,
    "save_best_only": false,
    "use_dynamic_sampler": true,
    "balance_ratio": 0.9,
    "use_amp": true,
    "use_attention_supervision": true,
    "attention_lambda": 0.5
  },

  "paths": {
    "checkpoint_dir": "./checkpoints_evormd",
    "log_dir": "./logs_evormd"
  }
}
