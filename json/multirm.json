{
  "experiment_name": "multirm_classification",

  "model": {
    "use_hierarchical": false,
    "cnn_hidden_dim": 64,
    "cnn_kernel_sizes": [1, 3, 5, 7],
    "cnn_dropout": 0.1,
    "gcn_hidden_dim": 128,
    "gcn_out_channels": 128,
    "gcn_num_layers": 3,
    "gcn_dropout": 0.3,
    "num_classes": 12,
    "num_attn_heads": 8,
    "attn_dropout": 0.1,
    "use_simple_pooling": false,
    "use_layer_norm": true
  },

  "training": {
    "numsample": 50,
    "batch_size": 48,
    "num_epochs": 100,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "train_ratio": 0.8,
    "random_seed": 666,
    "eval_threshold": 0.5,
    "test_interval": 10,
    "save_every_epoch": true,
    "use_amp": true
  },

  "paths": {
    "checkpoint_dir": "./checkpoints/multirm",
    "log_dir": "./logs/multirm"
  }
}
